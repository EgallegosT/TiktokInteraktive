# Tu usuario de TikTok (sin @). Debes estar EN VIVO al ejecutar npm start.
TIKTOK_USERNAME=tu_usuario

# Puertos (no cambiar salvo conflicto)
HTTP_PORT=3000
WS_PORT=8765

# true = probar sin live (teclas 1, 2, L, G en el juego)
DEMO_MODE=false

# Fuerza de likes y regalos (opcional)
LIKE_POWER=1.2
GIFT_BOOST_BASE=8
FOLLOW_BOOST=15

# Voz: lee comentarios de quien ya te sigue (altavoz del PC)
TTS_ENABLED=true
TTS_MIN_CHARS=8
TTS_COOLDOWN_MS=4500
TTS_LANG=es-MX

# Arena de burbujas
BUBBLE_LIKE_GROW=0.4
BUBBLE_GIFT_GROW=10

# Cofre del Live (barra colectiva)
COFRE_LIKE_FILL=0.12
COFRE_GIFT_FILL=9

# Dragón del Live (boss raid; la dificultad escala en el cliente por nº de héroes)
DRAGON_LIKE_DAMAGE=0.75
DRAGON_GIFT_DAMAGE=24

# Arena Roblox Live (sprint con avatares 2D)
ROBLOX_LIKE_PUSH=1.1
ROBLOX_GIFT_PUSH=14

# Rey de la colina
REY_LIKE_POINTS=1.2
REY_GIFT_POINTS=22

# Bola de cristal
CRYSTAL_ASK_COOLDOWN_MS=22000
CRYSTAL_MENTION_COOLDOWN_MS=40000
CRYSTAL_NUDGE_LIKES=32
